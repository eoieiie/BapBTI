    "expo": "~57.0.11",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.11",
