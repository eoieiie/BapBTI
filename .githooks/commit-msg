#!/bin/sh
# 커밋 메시지에 AI 서명이 들어가는 것을 기계적으로 차단 (CONTRIBUTING.md 규칙)
# 대상: Co-Authored-By 트레일러 전부, "Generated with" 문구, 로봇 이모지
# 설치: git config core.hooksPath .githooks  (클론 후 1회)

msg_file="$1"

if grep -qiE '^co-authored-by:|generated with|🤖' "$msg_file"; then
  echo "" >&2
  echo "✋ 커밋 거부: 메시지에 AI 서명(Co-Authored-By / Generated with)이 있습니다." >&2
  echo "   이 저장소의 커밋에는 사람 이름만 남깁니다 (CONTRIBUTING.md)." >&2
  echo "   해당 줄을 지우고 다시 커밋하세요." >&2
  exit 1
fi
exit 0
